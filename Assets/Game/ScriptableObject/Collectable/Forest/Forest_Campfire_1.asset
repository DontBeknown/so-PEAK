  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Forest_Campfire_1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Forest_Campfire_1
  headerName: Items Left Behind
  content: "\tOur group continues toward the Lighthouse. We've found a few useful
    items scattered near the campfires along the trail. They may be small things,
    but in times like these, even small things matter. We're leaving them here in
    case you pass through and need them.\r\n\n\tPlease rest when you can. Collapsing
    in the middle of nowhere without knowing it \u2014 that's a terrible way to go.
    We ourselves are running low on food and water. We hope you catch up before it's
    too late."
  type: 0
  biome: 0
