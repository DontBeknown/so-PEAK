  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Forest_Campfire_5
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Forest_Campfire_5
  headerName: The Statue
  content: "There is a statue on the mountain. In our desperation, we went to it.
    It seemed to possess some mechanism \u2014 it revealed the shortest path to the
    summit. But only for a moment. Only once. <b><color=#cc6600>When the path appeared
    before us, the statue crumbled and vanished.</color></b> \r\n\nPerhaps some wealthy
    eccentric built it for amusement. Perhaps it was left by something older and
    greater, to guide those still worth guiding."
  type: 0
  biome: 0
  icon: {fileID: 0}
  dialogData: {fileID: 0}
