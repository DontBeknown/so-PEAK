  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Forest_Campfire_3
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Forest_Campfire_3
  headerName: The Girl
  content: "\tThere is a girl named Tawan among us. Her friend was separated from
    the group, and ever since, Tawan has moved through the days like someone only
    half-present. Some mornings she doesn't eat at all. I've seen her, quietly, leaving
    supplies at the campfires we pass \u2014 provisions the group can ill afford
    to spare.\r\n\n\tWe tell her over and over: one girl, alone in a forest this
    vast, cannot easily be found. And yet she insists on going back. I've made it
    my quiet duty to keep her here \u2014 to hold her to living \u2014 because we
    cannot afford to lose another soul. The fewer we are, the nearer despair comes."
  type: 0
  biome: 0
  icon: {fileID: 0}
  dialogData: {fileID: 0}
