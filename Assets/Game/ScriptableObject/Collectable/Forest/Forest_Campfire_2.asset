  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Forest_Campfire_2
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Forest_Campfire_2
  headerName: The Animals
  content: "\tA mountain like this should be crowded with life. Deer. Bears. Turtles.
    Wolves. Snakes. But we've found nothing. Not a single creature to hunt. Only
    the sound of wolves, distant \u2014 never seen. Most of them have likely fled
    or gone still in the way that dying things do.\r\n\n\tBut luck, in its small
    way, holds. Certain plants remain \u2014 apple trees, berry bushes \u2014 still
    bearing fruit enough to keep us alive another day. Just barely. But enough."
  type: 0
  biome: 0
  icon: {fileID: 0}
  dialogData: {fileID: 0}
