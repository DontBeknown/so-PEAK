  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Forest_Campfire_7
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Forest_Campfire_7
  headerName: The Mushrooms
  content: "\tOne of our group ate something she shouldn't have. She collapsed not
    long after. Mushrooms, here \u2014 some of them will kill you, and we have no
    one who can tell the difference.\n\r\n\tAfter that, none of us touched anything
    fungal. Hunger is better than dead. But if we reach the edge of starvation, we
    may have no choice. We'll have to gamble. There's no forester among us, no botanist
    \u2014 only ordinary people who ran, and who keep running, and who want desperately
    to live."
  type: 0
  biome: 0
  icon: {fileID: 0}
  dialogData: {fileID: 0}
