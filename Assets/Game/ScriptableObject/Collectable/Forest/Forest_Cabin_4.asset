  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Forest_Cabin_4
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Forest_Cabin_4
  headerName: "House Notes \u2014 4"
  content: "\tThe Day of Ruin has come. Everything has already gone too far. I've
    known it for a long time \u2014 something wrong in the plants, the animals, the
    earth itself. The sounds they make are no longer the sounds I grew up with. Even
    the wind has gone quiet. It no longer speaks to me.\n\r\n\tSomething is beginning
    again. God is pressing reset. And this time \u2014 who survives? Everything,
    everyone, will be erased. Not even ground to stand on will remain. We will rise
    into the sky and beg for mercy one last time."
  type: 0
  biome: 0
  icon: {fileID: 0}
  dialogData: {fileID: 0}
