  m_Script: {fileID: 11500000, guid: b48b7ed3e5647da4191288c45520b384, type: 3}
  m_Name: 0_DialogStart
  m_EditorClassIdentifier: Assembly-CSharp::Game.Dialog.DialogData
  dialogId: 0_DialogStart
  lines:
  - speakerName: Aira
    text: "Okay. The coordinates from that radio static pointed here. \r\nI need
      to hurry before I get left behind here. \n(Press RIGHT CLICK to proceed) "
  - speakerName: Aira
    text: 'I got separated from the group a while ago.

      I need to hurry and
      rejoin them at the <b><color=#ffff00>Lighthouse</color></b>'
  - speakerName: Aira
    text: 'it has to be up at the summit.  '
  - speakerName: Aira
    text: "I just need to find a sign. A trail marker,  <b><color=#ffff00>a Campfire,
      \na House</color></b>, a piece of trash. Anything human. "
  - speakerName: Aira
    text: 'This is so lonely. I should write something down in my journal,

      so
      I''ll feel less lonely.'
