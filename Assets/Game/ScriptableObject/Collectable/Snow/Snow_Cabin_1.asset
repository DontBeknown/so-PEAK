  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Snow_Cabin_1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Snow_Cabin_1
  headerName: "House Notes \u2014 1"
  content: "\tMy reindeer wouldn't graze. They just stood still and stared at the
    sky. Then at midnight, a single violent tremor \u2014 and the whole herd ran
    into a fissure in the ice. A crack with no visible bottom. I couldn't reach the
    ropes in time.\n\r\n\tNow it's only me, and the silence, and the sour smell of
    soil rotting from below."
  type: 0
  biome: 2
  icon: {fileID: 0}
