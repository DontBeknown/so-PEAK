  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Snow_Campfire_3
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Snow_Campfire_3
  headerName: Food
  content: "\tNothing to hunt. No protein, no fat, nothing to stoke the body's furnace.
    What remains are a few hardy berry bushes \u2014 lingonberry, blueberry \u2014
    still clinging to the frozen ground. Without them, we would have nothing. We
    would have died already."
