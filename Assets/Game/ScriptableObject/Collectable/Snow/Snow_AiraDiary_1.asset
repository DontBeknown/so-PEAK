  m_Name: Snow_AiraDiary_1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Snow_AiraDiary_1
  headerName: "Aira's Diary \u2014 Entry 1"
  content: "\tI am lost. Again.\r\n\n\tThis place is enormous. White in every direction,
    swallowing everything, offering nothing to navigate by. Without the map, I'd
    be walking in circles until I stopped.\r\nWithin minutes of arriving, my hands
    began to go numb. Picking up anything is difficult. I don't know if this is where
    I finally stop, or if I have more walking left in me.\r\n\n\r\n\tI am so tired.\r\n\t\n\tI
    miss Tawan terribly.\r\n"
  type: 0
  biome: 2
  icon: {fileID: 0}
  dialogData: {fileID: 0}
