  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: TheEnd
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: TheEnd
  headerName: 'Last Diary '
  content: "\tWhen I finally reached the Lighthouse, there were survivors. Dozens
    of them, not the thousands the place was built to hold. Food and water in abundance
    for the population that should have arrived \u2014 but only a fraction of that
    number had made it.\r\n\n\tMost of them were young. Some middle-aged. No children.
    Not a single elderly face among them.\r\n\r\n\tAlong the way, there had been
    countless losses. No names recorded. No graves. The dead were swallowed into
    the dirt, the sand, the snow \u2014 dissolved back into the world that was ending.\r\n\r\n\tTawan
    was not here. Of the group that traveled with me, only a handful remain.\r\n\r\n\tTawan
    was not here.\r\r\n"
  type: 0
  biome: 2
  icon: {fileID: 0}
  dialogData: {fileID: 0}
