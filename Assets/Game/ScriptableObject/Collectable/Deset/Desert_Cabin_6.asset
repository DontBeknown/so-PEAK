  m_Name: Desert_Cabin_6
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Desert_Cabin_6
  headerName: "\u0E2A\u0E39\u0E15\u0E23\u0E15\u0E31\u0E4A\u0E01\u0E41\u0E15\u0E19\u0E17\u0E2D\u0E14"
  content: "\u0E2A\u0E39\u0E15\u0E23\u0E15\u0E31\u0E4A\u0E01\u0E41\u0E15\u0E19\u0E17\u0E2D\u0E14\u0E2A\u0E44\u0E15\u0E25\u0E4C\u0E2D\u0E32\u0E2B\u0E23\u0E31\u0E1A\n\r\n1.
    \u0E01\u0E32\u0E23\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E15\u0E31\u0E4A\u0E01\u0E41\u0E15\u0E19\r\n\u2022\t\u0E25\u0E49\u0E32\u0E07\u0E17\u0E33\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E30\u0E2D\u0E32\u0E14:
    \u0E19\u0E33\u0E15\u0E31\u0E4A\u0E01\u0E41\u0E15\u0E19\u0E2A\u0E14\u0E21\u0E32\u0E25\u0E49\u0E32\u0E07\u0E19\u0E49\u0E33\u0E43\u0E2B\u0E49\u0E2A\u0E30\u0E2D\u0E32\u0E14
    (\u0E0A\u0E32\u0E27\u0E40\u0E1A\u0E14\u0E39\u0E2D\u0E34\u0E19\u0E14\u0E31\u0E49\u0E07\u0E40\u0E14\u0E34\u0E21\u0E21\u0E31\u0E01\u0E08\u0E30\u0E25\u0E27\u0E01\u0E19\u0E49\u0E33\u0E40\u0E14\u0E37\u0E2D\u0E14\u0E01\u0E48\u0E2D\u0E19\u0E23\u0E2D\u0E1A\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E06\u0E48\u0E32\u0E40\u0E0A\u0E37\u0E49\u0E2D)\r\n\u2022\t\u0E14\u0E36\u0E07\u0E2A\u0E48\u0E27\u0E19\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E2D\u0E2D\u0E01:
    \u0E40\u0E14\u0E47\u0E14\u0E1B\u0E35\u0E01\u0E41\u0E25\u0E30\u0E02\u0E32\u0E2B\u0E19\u0E32\u0E21\u0E2A\u0E48\u0E27\u0E19\u0E17\u0E35\u0E48\u0E41\u0E02\u0E47\u0E07\u0E46
    \u0E2D\u0E2D\u0E01 (\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E02\u0E32\u0E04\u0E39\u0E48\u0E2B\u0E25\u0E31\u0E07\u0E44\u0E27\u0E49\u0E44\u0E14\u0E49\u0E16\u0E49\u0E32\u0E0A\u0E2D\u0E1A\u0E04\u0E27\u0E32\u0E21\u0E01\u0E23\u0E2D\u0E1A)\n\r\n2.
    \u0E2A\u0E48\u0E27\u0E19\u0E1C\u0E2A\u0E21\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E17\u0E28\r\n\u2022\t\u0E40\u0E01\u0E25\u0E37\u0E2D\u0E17\u0E30\u0E40\u0E25:
    \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E14\u0E36\u0E07\u0E23\u0E2A\u0E0A\u0E32\u0E15\u0E34\r\n\u2022\t\u0E1E\u0E23\u0E34\u0E01\u0E44\u0E17\u0E22\u0E14\u0E33:
    \u0E40\u0E1E\u0E34\u0E48\u0E21\u0E04\u0E27\u0E32\u0E21\u0E40\u0E1C\u0E47\u0E14\u0E23\u0E49\u0E2D\u0E19\u0E40\u0E25\u0E47\u0E01\u0E19\u0E49\u0E2D\u0E22\r\n\u2022\t\u0E1C\u0E07\u0E02\u0E21\u0E34\u0E49\u0E19
    (Turmeric): \u0E0A\u0E48\u0E27\u0E22\u0E43\u0E2B\u0E49\u0E2A\u0E35\u0E2A\u0E27\u0E22\u0E41\u0E25\u0E30\u0E14\u0E31\u0E1A\u0E01\u0E25\u0E34\u0E48\u0E19\u0E04\u0E32\u0E27\r\n\u2022\t\u0E19\u0E49\u0E33\u0E21\u0E31\u0E19\u0E1E\u0E37\u0E0A
    \u0E2B\u0E23\u0E37\u0E2D \u0E40\u0E19\u0E22\u0E43\u0E2A (Ghee): \u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E17\u0E2D\u0E14\n\r\n3.
    \u0E02\u0E31\u0E49\u0E19\u0E15\u0E2D\u0E19\u0E01\u0E32\u0E23\u0E17\u0E33\r\n1.\t\u0E04\u0E31\u0E48\u0E27\u0E41\u0E2B\u0E49\u0E07:
    \u0E19\u0E33\u0E15\u0E31\u0E4A\u0E01\u0E41\u0E15\u0E19\u0E25\u0E07\u0E44\u0E1B\u0E04\u0E31\u0E48\u0E27\u0E43\u0E19\u0E01\u0E23\u0E30\u0E17\u0E30\u0E40\u0E1B\u0E25\u0E48\u0E32\u0E14\u0E49\u0E27\u0E22\u0E44\u0E1F\u0E2D\u0E48\u0E2D\u0E19\u0E08\u0E19\u0E15\u0E31\u0E27\u0E40\u0E23\u0E34\u0E48\u0E21\u0E41\u0E2B\u0E49\u0E07\u0E41\u0E25\u0E30\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E2A\u0E35\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E35\u0E19\u0E49\u0E33\u0E15\u0E32\u0E25\u0E41\u0E01\u0E21\u0E41\u0E14\u0E07\r\n2.\t\u0E17\u0E2D\u0E14\u0E43\u0E2B\u0E49\u0E01\u0E23\u0E2D\u0E1A:
    \u0E43\u0E2A\u0E48\u0E19\u0E49\u0E33\u0E21\u0E31\u0E19\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E19\u0E22\u0E43\u0E2A\u0E25\u0E07\u0E44\u0E1B\u0E1E\u0E2D\u0E1B\u0E23\u0E30\u0E21\u0E32\u0E13
    \u0E40\u0E23\u0E48\u0E07\u0E44\u0E1F\u0E02\u0E36\u0E49\u0E19\u0E40\u0E25\u0E47\u0E01\u0E19\u0E49\u0E2D\u0E22
    \u0E17\u0E2D\u0E14\u0E08\u0E19\u0E15\u0E31\u0E4A\u0E01\u0E41\u0E15\u0E19\u0E01\u0E23\u0E2D\u0E1A\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E07\r\n3.\t\u0E04\u0E25\u0E38\u0E01\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E17\u0E28:
    \u0E42\u0E23\u0E22\u0E40\u0E01\u0E25\u0E37\u0E2D \u0E1E\u0E23\u0E34\u0E01\u0E44\u0E17\u0E22
    \u0E41\u0E25\u0E30\u0E1C\u0E07\u0E02\u0E21\u0E34\u0E49\u0E19\u0E25\u0E07\u0E44\u0E1B
    \u0E1C\u0E31\u0E14\u0E43\u0E2B\u0E49\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E17\u0E28\u0E40\u0E04\u0E25\u0E37\u0E2D\u0E1A\u0E15\u0E31\u0E27\u0E15\u0E31\u0E4A\u0E01\u0E41\u0E15\u0E19\u0E08\u0E19\u0E17\u0E31\u0E48\u0E27\r\n4.\t\u0E1E\u0E31\u0E01\u0E43\u0E2B\u0E49\u0E2A\u0E30\u0E40\u0E14\u0E47\u0E14\u0E19\u0E49\u0E33\u0E21\u0E31\u0E19:
    \u0E15\u0E31\u0E01\u0E02\u0E36\u0E49\u0E19\u0E1E\u0E31\u0E01\u0E44\u0E27\u0E49\u0E43\u0E2B\u0E49\u0E40\u0E22\u0E47\u0E19\u0E25\u0E07\u0E40\u0E25\u0E47\u0E01\u0E19\u0E49\u0E2D\u0E22
    (\u0E08\u0E30\u0E0A\u0E48\u0E27\u0E22\u0E43\u0E2B\u0E49\u0E01\u0E23\u0E2D\u0E1A\u0E22\u0E34\u0E48\u0E07\u0E02\u0E36\u0E49\u0E19)\r\n"
  type: 0
  biome: 1
