  m_Name: Desert_Cabin_5
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Desert_Cabin_5
  headerName: "House Notes \u2014 5"
  content: "\tThe gaps between the sand particles here are too wide. I poured just
    a small amount of water onto the surface \u2014 it vanished instantly, gone beneath
    the island without even moistening the top layer. No decayed organic matter,
    no dead roots or old bones to hold moisture or nutrients. This ground is perfect
    for storing heat. It is catastrophically bad at sustaining life."
  type: 0
  biome: 1
