  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Desert_Cabin_1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Desert_Cabin_1
  headerName: "House Notes \u2014 1"
  content: "I tried to dig into the surface of this island today. I wanted to plant
    the seeds I brought. But there is no soil here \u2014 not as I ever understood
    the word. Only shattered stone, ground down by wind and searing heat into something
    granular and hollow. Nothing to hold life. Nothing to hold water. Just an efficient
    machine for generating heat."
  type: 0
  biome: 1
  icon: {fileID: 0}
  dialogData: {fileID: 0}
