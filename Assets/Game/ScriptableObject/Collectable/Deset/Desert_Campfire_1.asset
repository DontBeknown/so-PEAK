  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Desert_Campfire_1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Desert_Campfire_1
  headerName: Food
  content: "\tWe found survivors who hadn't yet evacuated, and we brought them along.
    We've been learning to live in this dry country. One plant that remains is the
    acacia. Its resin is edible and can be used in cooking \u2014 but be careful:
    while the gum itself is safe, the leaves and pods of certain acacia species carry
    cyanide compounds. They will kill you. Know what you're eating.\r\n\n\tThe other
    plant worth knowing: the date palm. You may have heard that it sustains life
    in the desert. It's true \u2014 and beyond filling the stomach, it dulls the
    thirst somewhat as well. In a place like this, that matters."
  type: 0
  biome: 1
