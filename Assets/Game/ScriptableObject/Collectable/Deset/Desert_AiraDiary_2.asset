  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Desert_AiraDiary_2
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Desert_AiraDiary_2
  headerName: "Aira's Diary \u2014 Entry 2"
  content: "\tMy head is full. Information pouring in from every direction \u2014
    who could have anticipated needing to know how to survive a desert? Whoever left
    all these notes along the trail deserves something more than thanks. Without
    them, I'd be dead already.\r\n\n\tThe one good thing about this place: no trees
    to block the sightlines. I can see in every direction. What I cannot do is find
    food or water. The visibility that gives me direction gives me nothing to drink.\r\n\t\n\tThe
    heat is unbearable. When does this ever end? If not for this small journal, I
    think I'd have lost my mind by now. Things are scarce. But I have to survive.
    I have to stay alive."
  type: 0
  biome: 1
  icon: {fileID: 0}
  dialogData: {fileID: 0}
