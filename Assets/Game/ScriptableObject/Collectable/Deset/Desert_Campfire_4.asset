  m_Script: {fileID: 11500000, guid: 953c7de367e9d274988902a49d189cc6, type: 3}
  m_Name: Desert_Campfire_4
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Desert_Campfire_4
  headerName: Clothing
  content: "\tDo not \u2014 under any circumstances \u2014 remove your clothes. Without
    them, your sweat evaporates faster and you'll be dead before you know it. You
    may feel suffocated by the heat, but believe this: the discomfort of sweat is
    infinitely preferable to being cooked alive. Loose, light-colored clothes if
    you have them. The looser, the better."
  type: 0
  biome: 1
