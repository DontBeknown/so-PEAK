  m_Name: Desert_AiraDiary_1
  m_EditorClassIdentifier: Assembly-CSharp::Game.Collectable.CollectableItem
  id: Desert_AiraDiary_1
  headerName: "Aira's Diary \u2014 Entry 1"
  content: "\tThis is madness.\r\n\n\tI traveled all that way to reach what I thought
    was safety. It wasn't. I have to keep moving. On the way here, I watched the
    mountain I came from collapse into dust. I got out in time. Just barely.\n\r\n\tI'm
    exhausted down to something below the bone. And now I find that all that effort,
    all that walking, still hasn't brought me to the end. But Tawan is somewhere
    ahead. I have to reach her."
  type: 0
  biome: 1
  icon: {fileID: 0}
  dialogData: {fileID: 0}
