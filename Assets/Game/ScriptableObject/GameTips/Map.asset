  m_Script: {fileID: 11500000, guid: c317abc05a5214b44a82ca6bb8faf700, type: 3}
  m_Name: Map
  m_EditorClassIdentifier: Assembly-CSharp::Game.Tutorial.GameplayTipData
  tipId: Map
  slides:
  - title: PATH MAP
    bodyText: <color=#4A5D23><b>PATH MAP:</b></color> Displays the road network across
      the terrain. Use these for the most efficient travel.
    illustration: {fileID: 21300000, guid: f73b4d5faa16cff4ca53fd3c1730dfbc, type: 3}
  - title: LOW AREA
    bodyText: Cooler tones represent lower elevations.
    illustration: {fileID: 21300000, guid: 6cc38ad4dcf092d4a9b709b349a2e648, type: 3}
  - title: HIGH AREA
    bodyText: Warmer tones indicate higher peaks.
    illustration: {fileID: 21300000, guid: 8abc5a7ac81ce124b8d3ef0dc64c6fae, type: 3}
  - title: GENTLE SLOPE
    bodyText: Identified by <b>low line density</b>. These areas are easy to climb
      and safe for travel.
    illustration: {fileID: 21300000, guid: b9950b8db275db74399e4960405be9a1, type: 3}
  - title: STEEP SLOPE
    bodyText: Identified by <b>high line density</b>. These areas are difficult to
      traverse and may require more stamina.</color>
    illustration: {fileID: 21300000, guid: e9097dcb5fc3fed459f20013a295e3b7, type: 3}
