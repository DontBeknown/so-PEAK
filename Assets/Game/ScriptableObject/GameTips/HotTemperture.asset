  m_Script: {fileID: 11500000, guid: c317abc05a5214b44a82ca6bb8faf700, type: 3}
  m_Name: HotTemperture
  m_EditorClassIdentifier: Assembly-CSharp::Game.Tutorial.GameplayTipData
  tipId: heat
  slides:
  - title: Heatstroke
    bodyText: In the <color=#8B4513><b>Desert</b></color>, players may suffer from
      <b><color=#B22222>Heatstroke</color></b>, causing thirst to increase rapidly.
      If left untreated, the player will <color=#D2691E><b>take continuous damage</b></color>.
    illustration: {fileID: 21300000, guid: ac6e832322eb5f04896205ccd4100e49, type: 3}
  - title: 
    bodyText: The simplest prevention is <b>drinking water</b>, which grants a temporary
      <color=#008B8B>Heat Resistance</color> buff.
    illustration: {fileID: 21300000, guid: a0d0f2d89b3163541beb3ec32f8ca3bb, type: 3}
  - title: 
    bodyText: For a <b>better solution</b>, players should look for equipment with
      <b>Temperature Regulation</b> or Heat Resistance modifiers, often found in
      <color=#4A5D23>cabins</color> and near <color=#E65100>campfires</color> throughout
      the level.
    illustration: {fileID: 21300000, guid: 935cbee9aa2f07442a005cfaf883472e, type: 3}
