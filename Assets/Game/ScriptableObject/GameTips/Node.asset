  m_Script: {fileID: 11500000, guid: c317abc05a5214b44a82ca6bb8faf700, type: 3}
  m_Name: Node
  m_EditorClassIdentifier: Assembly-CSharp::Game.Tutorial.GameplayTipData
  tipId: Node
  slides:
  - title: STATUE
    bodyText: In every level, look for <color=#4A5D23><b>Statues</b></color>  across
      the map. Interacting with one will reveal the way to the <color=#E65100><b>Lighthouse</b></color>.
    illustration: {fileID: 21300000, guid: d7bf282d82a6ba748b0d4bd842562a2c, type: 3}
  - title: STATUE
    bodyText: '<b>This will:</b>

      1. Automatically open your <color=#005A9C><b>Contour
      Map</b></color> to show your position and the path.

'
    illustration: {fileID: 21300000, guid: 3b6d2844646e49248a1b6b29976ba4bd, type: 3}
  - title: STATUE
    bodyText: '2. Generate a <b>Visual Guide</b> directly in the world.

      <i><color=#B22222><b>Note:</b>
      The path is temporary and will fade after a short time!</color></i></color>'
    illustration: {fileID: 21300000, guid: 26529281076c6c6449a417d68bb288c5, type: 3}
